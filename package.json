    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.6",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
